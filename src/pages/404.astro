---
import Base from "../layouts/Base.astro";
---

<Base title="Page introuvable" description="Cette page n'existe pas.">
  <div class="py-32 text-center">
    <h1 class="text-6xl font-heading font-extrabold text-gray-300 mb-4">404</h1>
    <p class="text-lg text-gray-500 mb-8">Cette page n'existe pas.</p>
    <a href="/" class="inline-block px-6 py-3 bg-primary-600 text-white rounded-xl font-medium hover:bg-primary-700 transition-colors">
      Retour à l'accueil
    </a>
  </div>
</Base>
